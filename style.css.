
:root {
  --bg: #050807;
  --panel: #0b110e;
  --green: #00f56a;
  --text: #f2fff5;
  --muted: #8a9b90;
  --border: rgba(0, 245, 106, 0.35);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, sans-serif;
}

button, textarea, input {
  font: inherit;
}

.topbar {
  height: 70px;
  padding: 0 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  background: #080d0a;
}

.logo {
  color: white;
  font-size: 24px;
  font-weight: 900;
  text-decoration: none;
  letter-spacing: 2px;
}

.logo span,
h1 span {
  color: var(--green);
}

.online {
  color: var(--green);
  font-size: 11px;
  letter-spacing: 2px;
}

.layout {
  display: flex;
  min-height: calc(100vh - 70px);
}

.sidebar {
  width: 235px;
  padding: 28px 18px;
  border-right: 1px solid var(--border);
  background: #080d0a;
  display: flex;
  flex-direction: column;
}

.sidebar h3 {
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 2px;
  margin: 0 0 20px;
}

.nav {
  background: transparent;
  color: #b7c7bc;
  border: 1px solid transparent;
  padding: 14px;
  margin-bottom: 9px;
  border-radius: 10px;
  text-align: left;
  cursor: pointer;
}

.nav:hover,
.nav.active {
  color: var(--green);
  border-color: var(--border);
  background: rgba(0, 245, 106, 0.07);
}

.sidebar-bottom {
  margin-top: auto;
  color: var(--muted);
  font-size: 11px;
}

.sidebar-bottom strong {
  color: var(--green);
  letter-spacing: 2px;
}

.workspace {
  flex: 1;
  min-width: 0;
  padding: 45px;
}

.panel {
  display: none;
  max-width: 900px;
  margin: auto;
}

.panel.active {
  display: block;
}

.eyebrow {
  color: var(--green);
  letter-spacing: 3px;
  font-size: 11px;
}

h1 {
  font-size: clamp(36px, 6vw, 65px);
  line-height: 1.12;
  margin: 18px 0;
}

h2 {
  color: var(--green);
}

.intro,
.panel > p {
  color: var(--muted);
  line-height: 1.7;
}

.suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 28px 0;
}

.suggestion,
.secondary {
  color: var(--green);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 16px;
  cursor: pointer;
}

.suggestion:hover,
.secondary:hover {
  background: rgba(0, 245, 106, 0.12);
}

.chat-box {
  min-height: 170px;
  max-height: 350px;
  overflow-y: auto;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--panel);
  margin-bottom: 14px;
}

.message {
  max-width: 85%;
  padding: 13px 16px;
  border-radius: 12px;
  margin-bottom: 12px;
  line-height: 1.5;
}

.assistant {
  background: #142019;
  border: 1px solid var(--border);
}

.user {
  margin-left: auto;
  background: #07351b;
  border: 1px solid var(--green);
}

.composer {
  display: flex;
  align-items: stretch;
  gap: 10px;
}

textarea,
input[type="file"] {
  width: 100%;
  color: var(--text);
  background: var(--panel);
  border: 1px solid var(--green);
  border-radius: 10px;
  padding: 15px;
}

textarea {
  min-height: 100px;
  resize: vertical;
}

.composer textarea {
  min-height: 60px;
}

textarea:focus,
input:focus {
  outline: 1px solid var(--green);
  box-shadow: 0 0 12px rgba(0, 245, 106, 0.15);
}

textarea::placeholder {
  color: #718078;
}

.send,
.primary {
  color: #001b0b;
  background: var(--green);
  border: none;
  border-radius: 10px;
  padding: 14px 20px;
  font-weight: bold;
  cursor: pointer;
}

.send {
  align-self: stretch;
}

.primary {
  margin-top: 14px;
}

.hint,
.status {
  color: var(--muted);
  font-size: 12px;
}

video {
  display: block;
  width: 100%;
  max-height: 450px;
  margin-top: 20px;
  border-radius: 12px;
  background: black;
}

video[hidden] {
  display: none;
}

@media (max-width: 700px) {
  .topbar {
    height: 60px;
    padding: 0 16px;
  }

  .logo {
    font-size: 19px;
  }

  .online {
    font-size: 9px;
  }

  .layout {
    display: block;
  }

  .sidebar {
    width: 100%;
    padding: 12px;
    border-right: none;
    border-bottom: 1px solid var(--border);
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
  }

  .sidebar h3,
  .sidebar-bottom {
    display: none;
  }

  .nav {
    flex: 1 1 42%;
    margin: 0;
    padding: 11px 7px;
    text-align: center;
    font-size: 12px;
  }

  .workspace {
    padding: 25px 15px;
  }

  h1 {
    font-size: 39px;
  }

  .suggestion {
    flex: 1 1 45%;
    font-size: 12px;
    padding: 11px 7px;
  }

  .message {
    max-width: 95%;
  }

  .send {
    padding: 12px;
  }
}
